{
  "name": "vidrelay",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @vidrelay/frontend --filter @vidrelay/backend --parallel dev",
    "dev:frontend": "pnpm --filter @vidrelay/frontend dev",
    "dev:backend": "pnpm --filter @vidrelay/backend dev",
    "types:generate": "pnpm --filter @vidrelay/backend types:generate",
    "generate": "pnpm --filter @vidrelay/backend db:generate",
    "migrate:local": "pnpm --filter @vidrelay/backend db:migrate:local",
    "migrations:rehearse": "pnpm --filter @vidrelay/backend db:migrations:rehearse",
    "migrations:list:remote": "pnpm --filter @vidrelay/backend db:migrations:list:remote",
    "migrate:remote": "pnpm --filter @vidrelay/backend db:migrate:remote",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "fallow": "fallow dead-code --fail-on-issues && fallow dupes && fallow health --baseline fallow-baselines/health.json --baseline-mode identity",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm migrations:rehearse && pnpm test && pnpm fallow && pnpm build",
    "deploy:frontend": "pnpm --filter @vidrelay/frontend deploy",
    "deploy:backend": "pnpm --filter @vidrelay/backend deploy"
  },
  "devDependencies": {
    "fallow": "3.14.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3"
  }
}
