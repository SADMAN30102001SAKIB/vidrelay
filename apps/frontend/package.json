{
  "name": "@vidrelay/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack --port 3000",
    "build": "next build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "pnpm build && wrangler pages dev out --port 3000",
    "deploy": "pnpm build && wrangler pages deploy out --project-name vidrelay --branch main"
  },
  "dependencies": {
    "@vidrelay/shared": "workspace:*",
    "clsx": "2.1.1",
    "lucide-react": "1.30.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "10.1.8",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "wrangler": "4.120.0"
  }
}
